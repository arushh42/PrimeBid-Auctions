# Copy this file to config.env for local development (config.env is git-ignored).
# In production, set these as environment variables on your host instead.

NODE_ENV=development
PORT=4000

# MongoDB (e.g. MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
DB_NAME=MERN_AUCTION_PLATFORM

# Where the frontend is served from. Comma-separate multiple origins.
# Not needed when the backend serves the built frontend itself (single-service deploy).
FRONTEND_URL=http://localhost:5173

# Auth. Generate a secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRE=7d
COOKIE_EXPIRE=7
# lax (default) works when frontend and API share a site (same origin, or app.example.com + api.example.com).
# Use "none" only if the frontend and API live on unrelated domains (Safari may still block it).
COOKIE_SAMESITE=lax
# Number of reverse proxies in front of the app (1 on Render/Railway/Heroku).
TRUST_PROXY=1

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (winner/settlement emails + contact form). Leave blank to disable email.
# Use either SMTP_SERVICE (e.g. gmail) or SMTP_HOST + SMTP_PORT.
SMTP_SERVICE=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_MAIL=
SMTP_PASSWORD=
# Inbox that receives contact-form messages (defaults to SMTP_MAIL)
CONTACT_RECEIVER_EMAIL=

# Business settings
APP_NAME=PrimeBid
COMMISSION_RATE=0.05

# Set to "false" to disable background jobs (e.g. on extra instances)
ENABLE_CRON=true
# Set to "false" to stop the API from serving frontend/dist
SERVE_CLIENT=true

# Used only by `npm run create-admin`
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
