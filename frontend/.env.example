# Optional. Leave unset to call the API on the same origin at /api/v1
# (Vite dev proxy locally; backend-served build or host rewrite in production).
# Only set this if the API is on a different domain, e.g. https://api.example.com/api/v1
VITE_API_URL=

# Optional. Where the Vite dev server forwards /api (default http://localhost:4000)
VITE_DEV_API_PROXY=
